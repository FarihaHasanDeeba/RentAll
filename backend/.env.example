PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rentall
CLIENT_URL=http://localhost:5173

# --- SSLCommerz (mocked for this build) ---
# In a real deployment these come from the SSLCommerz merchant panel.
# The mock service in src/services/sslcommerzMockService.js ignores their
# values but they are kept here so swapping in the real `sslcommerz-lts`
# SDK later only means changing that one file.
SSLCOMMERZ_STORE_ID=mock_store_id
SSLCOMMERZ_STORE_PASSWORD=mock_store_password
SSLCOMMERZ_IS_LIVE=false
