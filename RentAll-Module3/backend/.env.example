# RentAll Module 3 - Backend environment
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rentall
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Google Maps Geocoding API (required for address -> coordinates)
GOOGLE_MAPS_API_KEY=

# Optional Twilio SMS. If empty in development, OTP is returned by the API for testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Development only
NODE_ENV=development
